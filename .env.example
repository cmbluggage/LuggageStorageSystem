# ─────────────────────────────────────────────────────────────
# Stowaway — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Settings > API Keys in your Supabase project. Supabase renamed the
# key types: use the "Publishable and secret API keys" tab, not the
# "Legacy API Keys" tab (anon/service_role still work if you already
# have them, but legacy keys are slated for deprecation end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key (sb_publishable_..., was "anon"). Ships to the
# browser — this is expected. Since migration 004 it has read access
# to the public catalog only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_..., was "service_role"). SERVER ONLY — never
# prefix with NEXT_PUBLIC_. Bypasses RLS and is the sole write path
# for bookings, pricing and settings. Without it every write fails
# and the app is read-only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email OTP (required) ──────────────────────────────────────
# Keys every verification code's HMAC — never store the raw code itself.
# Without this, email verification (booking creation + /my-bookings) is
# down entirely, not degraded. Generate a random 32+ byte secret once per
# deployment and never rotate it casually — rotating invalidates every
# code currently in flight. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=

# ── Cloudflare Turnstile (optional) ──────────────────────────
# Bot protection on booking creation. Both keys must be set AND the
# `turnstile_enabled` setting switched on in the admin panel — either
# alone is a no-op, so a flag flipped without keys cannot lock customers out.
# Keys: https://dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Currency (optional) ──────────────────────────────────────
# Startup fallback only. The live rate is served by /api/exchange-rate,
# and the persistent fallback is the `usd_to_lkr_rate` admin setting.
NEXT_PUBLIC_USD_TO_LKR=320

# ── Site URL (recommended) ───────────────────────────────────
# Canonical production origin, used by sitemap.ts/robots.ts/metadataBase
# and as the fallback link base in emails. Falls back to a placeholder
# domain if unset.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Stripe (optional — real integration, not a simulation) ───
# Until STRIPE_SECRET_KEY is set, card payments settle instantly via the
# no-gateway-configured dev fallback in db.ts (updateBookingPayment) —
# fine for local dev/demos, not for production. Set both keys to go live;
# nothing else in the app needs to change when you do.
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret — https://dashboard.stripe.com/webhooks
# Add an endpoint pointed at POST {your domain}/api/stripe/webhook,
# subscribed to: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET=

# ── Email (optional — real integration, gated by configuration) ─
# Resend is tried first; SMTP is the backup transport (works with any
# provider, including a shared-hosting mailbox like Hostinger's). Neither
# configured = emails are logged as failed in email_log, nothing else breaks.
# EMAIL_FROM must be a domain you've verified with whichever provider sends it.
EMAIL_FROM="Luggage Storage Colombo <bookings@yourdomain.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
